# Get a token from Telegram @BotFather
BOT_TOKEN=replace_with_your_bot_token

# LLM API (any OpenAI-compatible endpoint: OpenAI, Gemini, Groq, OpenRouter...)
LLM_API_KEY=replace_with_your_llm_api_key
LLM_MODEL=gpt-4o-mini
# Leave empty for OpenAI. Examples:
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# Shop name used in the greeting and the agent prompt
SHOP_NAME=Mây Cafe

# Optional; defaults shown
# STORES_FILE=data/stores.json
# DB_PATH=data/cskh.sqlite3
